# --- Core ---
# Master key for AES-256-GCM encryption of credentials (base64, 32 bytes). Generate:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_MASTER_KEY=
APP_JWT_SECRET=
APP_DATABASE_URL=postgresql+psycopg://aisw:aisw@postgres:5432/aisw
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080
# Directories allowed for source.repo mode=path (comma separated)
APP_SCAN_ROOTS=/app/fixtures
APP_UPLOAD_RETENTION_HOURS=72
# Run worker inside API process (dev only)
APP_INPROCESS_WORKER=false
# Extra hosts allowed for outgoing requests besides public internet (host:port, comma separated)
APP_SSRF_ALLOW_HOSTS=
