# Copy to .env and adjust. Every value is optional for a local demo.

# --- Mode & keys ---
# dev: missing keys are generated once into the shared data volume (demo only).
# prod: APP_MASTER_KEY and APP_JWT_SECRET are required. Generate each with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_ENV=dev
# AES-256-GCM master key for credentials; rotation: "1:<old b64>,2:<new b64>" (the highest version encrypts)
APP_MASTER_KEY=
APP_JWT_SECRET=
POSTGRES_PASSWORD=aisw

# --- URLs & ports ---
APP_PUBLIC_URL=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Sources ---
# Directories allowed for source.repo mode=path (inside the container), comma separated
APP_SCAN_ROOTS=/app/fixtures
# Uploaded archives are stored encrypted and deleted after this many hours
APP_UPLOAD_RETENTION_HOURS=72

# --- Outgoing requests ---
# Hosts in the private network the SSRF guard may reach (host:port). Defaults cover the mock and ollama profiles.
APP_SSRF_ALLOW_HOSTS=mock:8025,mock:8026,mock:2525,ollama:11434
# Offline demo: send Telegram messages to the mock instead of api.telegram.org
# APP_TELEGRAM_API_BASE=http://mock:8025

# Отправитель одноразовых кодов новой регистрации. Для Яндекса: smtp.yandex.ru, 465, tls.
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_SECURITY=starttls
APP_SMTP_FROM=
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=

# --- AI provider for workspaces using the platform settings ---
# nvidia (Nemotron) | ollama. Without a configured key, NVIDIA is unavailable.
LLM_ENABLED=true
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# Shared by NVIDIA and the public Telegram Bot API. Local Telegram mocks connect directly.
# Proxy URLs or ip:port:login:password, separated by commas.
# When empty, both use GEMENI_PROXIES or GEMINI_PROXIES (in that order).
NVIDIA_PROXIES=
# Compose reaches the Ollama container by its service name.
# For a native backend, use http://localhost:11434 in backend/.env.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
